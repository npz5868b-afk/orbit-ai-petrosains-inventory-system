  "components": {
    "schemas": {
      "CheckoutRequest": {
        "properties": {
          "client_transaction_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Client Transaction Id"
          },
          "store_id": {
            "type": "string",
            "title": "Store Id"
          },
          "user_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "User Name"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/TransactionLine"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Items"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_transaction_id",
          "store_id",
          "items"
        ],
        "title": "CheckoutRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReturnLine": {
        "properties": {
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "detection_id": {
            "type": "string",
            "title": "Detection Id"
          },
          "condition": {
            "type": "string",
            "enum": [
              "good",
              "damaged",
              "unknown"
            ],
            "title": "Condition",
            "default": "good"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "item_id",
          "quantity",
          "unit",
          "detection_id"
        ],
        "title": "ReturnLine"
      },
      "ReturnRequest": {
        "properties": {
          "client_transaction_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Client Transaction Id"
          },
          "scan_session_id": {
            "type": "string",
            "title": "Scan Session Id"
          },
          "store_id": {
            "type": "string",
            "title": "Store Id"
          },
          "user_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "User Name"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReturnLine"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_transaction_id",
          "scan_session_id",
          "store_id",
          "items"
        ],
        "title": "ReturnRequest"
      },
      "ReviewRequest": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "confirm",
              "choose_another",
              "scan_again",
              "reject"
            ],
            "title": "Action"
          },
          "selected_item_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Item Id"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "reviewed_by": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewed By"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action"
        ],
        "title": "ReviewRequest"
      },
      "SyncOperation": {
        "properties": {
          "client_transaction_id": {
            "type": "string",
            "title": "Client Transaction Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "checkout",
              "return"
            ],
            "title": "Type"
          },
          "created_offline_at": {
            "type": "string",
            "title": "Created Offline At"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_transaction_id",
          "type",
          "created_offline_at",
          "payload"
        ],
        "title": "SyncOperation"
      },
      "SyncRequest": {
        "properties": {
          "device_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Device Id"
          },
          "operations": {
            "items": {
              "$ref": "#/components/schemas/SyncOperation"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Operations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "device_id",
          "operations"
        ],
        "title": "SyncRequest"
      },
      "TransactionLine": {
        "properties": {
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "item_id",
          "quantity",
          "unit"
        ],
        "title": "TransactionLine"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
