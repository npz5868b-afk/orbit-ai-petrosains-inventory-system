{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"], "types": ["node"], "strict": true,
    "noEmitOnError": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "rootDir": "../..", "outDir": "../../.test-tmp/programmes-api"
  },
  "include": ["../../lib/programmes/**/*.ts", "../../app/api/programmes/**/*.ts"]
}
