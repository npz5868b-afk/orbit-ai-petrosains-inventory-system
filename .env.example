# Frontend
NEXT_PUBLIC_ORBIT_API_URL=http://127.0.0.1:8000/api

# Backend
ORBIT_DB_PATH=backend/data/orbit.db
ORBIT_DETECTOR_MODE=mock
ORBIT_READY_THRESHOLD=0.85
ORBIT_REVIEW_THRESHOLD=0.60
ORBIT_MAX_IMAGE_BYTES=10485760
ORBIT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required only when ORBIT_DETECTOR_MODE=real
ORBIT_MODEL_WEIGHTS=
ORBIT_OCR_ENABLED=true
ORBIT_OCR_MIN_CONFIDENCE=0.50
ORBIT_OCR_CROP_PADDING=0.08
ORBIT_OCR_TIMEOUT_SECONDS=5.0

# Render backend deployment example
# ORBIT_DB_PATH=/var/data/orbit.db
# ORBIT_DETECTOR_MODE=real
# ORBIT_MODEL_WEIGHTS=backend/models/orbit_ai_5class_yolo11n_best.pt
# ORBIT_OCR_ENABLED=true
# ORBIT_CORS_ORIGINS=https://your-vercel-app.vercel.app
